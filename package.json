{
  "name": "toni-ai-agent",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/tests/**/*.test.js",
    "start": "node dist/app/interactive-cli.js",
    "start:plan": "node dist/app/cli.js",
    "start:web": "node dist/app/local-web-server.js",
    "dev": "node --watch --import tsx app/interactive-cli.ts",
    "dev:plan": "node --import tsx app/cli.ts",
    "dev:web": "node --watch --import tsx app/local-web-server.ts"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "docx": "^9.7.1",
    "openai": "^7.9.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": { "@types/node": "^22.15.0", "tsx": "^4.19.0", "typescript": "^5.8.0" }
}
