{
  "name": "toni-ai-agent",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/tests/**/*.test.js",
    "start": "node dist/app/interactive-cli.js",
    "start:plan": "node dist/app/cli.js",
    "start:web": "node dist/app/local-web-server.js",
    "dev": "node --watch --import tsx app/interactive-cli.ts",
    "dev:plan": "node --import tsx app/cli.ts",
    "dev:web": "node --watch --import tsx app/local-web-server.ts",
    "backup": "node dist/ops/backup.js",
    "restore": "node dist/ops/restore.js",
    "rotate-logs": "node dist/ops/rotate-logs.js",
    "verify-installation": "node dist/ops/verify-installation.js",
    "audit:high": "npm audit --audit-level=high",
    "test:unit": "node --test dist/tests/**/*.test.js",
    "test:resilience": "node --test dist/tests/resilience/**/*.test.js",
    "test:load": "node --test dist/tests/load/**/*.test.js",
    "security:boundaries": "node scripts/check-security-boundaries.mjs",
    "test:all": "npm run check && npm run build && npm run security:boundaries && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "openai": "^7.9.0",
    "playwright": "^1.55.0",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "@types/better-sqlite3": "^7.6.13"
  }
}
